{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "0.4.7",
  "description": "__MSG_appDesc__",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "WeMD (Alt+Shift+M)"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open WeMD popup / 打开 WeMD"
    }
  },
  "minimum_chrome_version": "102",
  "optional_host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "wemd@zyx.pink",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}